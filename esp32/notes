# init
. ~/esp/esp-idf/export.sh

# menu
idf.py menuconfig

# full clean
idf.py fullclean

# reconfig
idf.py -DIDF_TARGET=esp32s3 -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;devices/sdkconfig.espressif-s3-wroom-1" reconfigure
idf.py -DIDF_TARGET=esp32s3 -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;devices/sdkconfig.muse;devices/sdkconfig.espressif-s3-wroom-1" reconfigure

# build
idf.py build flash monitor

# check
esptool.py --port /dev/ttyUSB0 flash_id
esptool.py flash_id